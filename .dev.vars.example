# Only needed for live exercises. Never paste the key into your coding-agent chat.
OPENROUTER_API_KEY=
# Raw OpenRouter IDs. The app adds Flue's openrouter/ prefix.
TRIAGE_MODEL=nvidia/nemotron-3-super-120b-a12b:free
JUDGE_MODEL=deepseek/deepseek-v4.1-flash
# Optional preferred OpenRouter provider for the judge; blank uses automatic routing.
JUDGE_PROVIDER=deepseek
# Jev-only judging needs only this key. Keep all keys in the ignored .dev.vars file.
TYPESAFE_API_KEY=
